{
  "name": "lgu-static-template",
  "version": "1.0.0",
  "description": "Reusable static local government website template",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "node scripts/build-static.js",
    "build:major": "node scripts/build-static.js",
    "build:minor": "node scripts/build-static.js",
    "serve": "node scripts/dev.js",
    "serve:dist": "cd dist && python3 -m http.server 8080",
    "version:major": "node scripts/bump-version.js major",
    "version:minor": "node scripts/bump-version.js minor",
    "version:patch": "node scripts/bump-version.js patch",
    "version:check": "node scripts/bump-version.js",
    "test": "npm run build && playwright test",
    "test:chrome": "npm run build && playwright test --project=chrome",
    "test:report": "playwright show-report",
    "lighthouse": "lhci autorun",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package": "bash scripts/package-cpanel.sh --build",
    "package:only": "bash scripts/package-cpanel.sh",
    "audit:template": "node scripts/audit-template.js",
    "test:layouts": "node --test scripts/tests/*.test.js",
    "capture:interface": "node scripts/capture-interface.js",
    "report:interface": "node scripts/interface-report.js",
    "audit:contrast": "node scripts/check-interface-contrast.js"
  },
  "keywords": [
    "template",
    "government",
    "lgu",
    "static"
  ],
  "author": "<placeholder>",
  "license": "MIT",
  "devDependencies": {
    "@babel/cli": "^7.23.9",
    "@babel/core": "^7.29.6",
    "@babel/preset-env": "^7.23.9",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.61.0",
    "clean-css-cli": "^5.6.3",
    "core-js": "^3.40.0",
    "html-minifier-terser": "^7.2.0",
    "playwright": "^1.61.0",
    "prettier": "^3.8.1",
    "terser": "^5.44.1",
    "axe-core": "^4.11.2"
  },
  "overrides": {
    "tmp": "0.2.7",
    "js-yaml": "^4.3.2",
    "uuid": "^11.1.1"
  }
}
